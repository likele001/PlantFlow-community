# PlantFlow 社区版 · 全栈部署环境变量模板
# 用法：
#   cp .env.fullstack.example .env.fullstack
#   vim .env.fullstack          # 至少设置 POSTGRES_PASSWORD 与 LLM_MASTER_KEY
#   docker compose -f docker-compose.fullstack.yml --env-file .env.fullstack up -d --build

# ---------- 数据库（全栈内置 PostgreSQL，带 pgvector） ----------
POSTGRES_DB=plantflow
POSTGRES_USER=plantflow
#POSTGRES_PASSWORD=改为强密码

# ---------- 缓存 Redis（可选密码，默认留空） ----------
# 若启用此处密码，请同时把 redis 服务的启动参数改为 --requirepass <密码>
REDIS_PASSWORD=

# ---------- LLM 密钥加密主密钥（必填） ----------
# 生成：openssl rand -hex 32
#LLM_MASTER_KEY=

# ---------- 运行参数 ----------
WORKER_CONCURRENCY=4

# ---------- 全栈对外端口（默认值，已被 compose 锁定前缀 FS_） ----------
FS_APP_PORT=5000
FS_POSTGRES_PORT=5544
FS_REDIS_PORT=6383